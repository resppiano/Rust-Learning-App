# --- Server ---
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# --- Database (PostgreSQL 14+ with pgvector) ---
DATABASE_URL=postgresql://rust_learner:dev_password@localhost:5432/rust_learning

# --- OpenRouter (OpenAI-compatible) ---
# Get a key at https://openrouter.ai/keys  (format: sk-or-v1-...)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CHAT_MODEL=openai/gpt-4o
EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Book ingestion (optional) ---
# Absolute path to "The Rust Programming Language" PDF for `npm run ingest-book`
BOOK_PDF_PATH=/absolute/path/to/The Rust Programming Language.pdf
